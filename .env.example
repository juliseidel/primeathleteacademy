# =============================================================================
# Prime Athlete Academy — Off-Season Plan Verkauf
# -----------------------------------------------------------------------------
# Kopiere diese Datei nach `.env.local` (gitignored) und befülle die Werte.
# =============================================================================

# Public Site URL (für Stripe-Redirects und absolute Links)
# - Lokal: http://localhost:3000
# - Production: https://primeathleteacademy.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project: qrsbkofbikbxkmzyuibc (juliseidel's Org)
# Region: eu-west-1
NEXT_PUBLIC_SUPABASE_URL=https://qrsbkofbikbxkmzyuibc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Role-Key — NIEMALS im Client verwenden. Nur server-side in
# API Routes / Webhooks. Aus dem Supabase Dashboard → Project Settings →
# API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe (siehe docs/stripe-setup.md)
# -----------------------------------------------------------------------------
# Testmodus während Entwicklung — sk_test_… / pk_test_… aus Stripe Dashboard
# Live nach Verifizierung — sk_live_… / pk_live_…
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret aus Stripe Dashboard → Entwickler → Webhooks
# Für lokale Tests: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# gibt ein temporäres whsec_… aus.
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# E-Mail-Versand via Gmail / Google Workspace SMTP
# -----------------------------------------------------------------------------
# Nutzt das bestehende Google-Workspace-Konto der PAA-Domain — KEIN DNS-Setup
# nötig (SPF auf Google ist bereits gesetzt).
#
# App-Passwort erstellen: Google-Konto → Sicherheit → 2-Faktor aktivieren →
# App-Passwörter → neues erstellen (16-stelliger Code, OHNE Leerzeichen eintragen).
GMAIL_USER=primeathleteacademy@primeathleteacademy.com
GMAIL_APP_PASSWORD=

# Optional: abweichende Absender-/Antwort-Adresse (Standard = GMAIL_USER)
# GMAIL_FROM=primeathleteacademy@primeathleteacademy.com
# MAIL_REPLY_TO=primeathleteacademy@primeathleteacademy.com
